# Neon Postgres connection string (postgresql://user:password@host/db?sslmode=require)
DATABASE_URL=

# Server port (defaults to 5000 if unset)
PORT=5000

# Server bind address (defaults to 127.0.0.1 if unset)
HOST=127.0.0.1

# development | production
NODE_ENV=development

# HTTP Basic Auth — leave both unset to disable (default, used for local
# dev). Set both to require a username/password on every request, e.g.
# when deployed somewhere reachable from the public internet.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
